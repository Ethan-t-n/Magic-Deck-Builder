# Optional AI settings. pnpm dev loads .env from the repository root.
# Start Ollama and install your chosen model before enabling these lines.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b
# Ollama requires a placeholder key for OpenAI-compatible clients.
# OPENAI_API_KEY=ollama

# Alternatively, supply credentials and a model for a hosted AI provider.
# Hosted providers may charge for requests.
